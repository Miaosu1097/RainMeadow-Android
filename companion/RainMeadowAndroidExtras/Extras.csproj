<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RainMeadowAndroidExtras</AssemblyName>
    <RootNamespace>RainMeadowAndroidExtras</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    GameManaged   : Game Managed directory containing Assembly-CSharp.dll, BepInEx.dll, and UnityEngine DLLs.
    RainMeadowDll : Compiled Android Rain Meadow assembly.
    NewtonsoftDll : Newtonsoft.Json.dll

    Pass these external build inputs with -p: when building the standalone plugin.
  -->
  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">libs/game/Managed</GameManaged>
    <RainMeadowDll Condition="'$(RainMeadowDll)' == ''">$(GameManaged)/Rain Meadow.dll</RainMeadowDll>
    <NewtonsoftDll Condition="'$(NewtonsoftDll)' == ''">$(GameManaged)/Newtonsoft.Json.dll</NewtonsoftDll>
    <OutputPath>bin/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameManaged)/BepInEx.dll</HintPath>
      <Private>false</Private>
      <!--
        Assembly-CSharp.dll includes a BepInEx shim with types such as BaseUnityPlugin and BepInPlugin.
        Use a reference alias to avoid duplicate type errors (CS0433).
        The source uses extern alias bepinex and imports bepinex::BepInEx.
      -->
      <Aliases>bepinex</Aliases>
    </Reference>
    <Reference Include="PUBLIC-Assembly-CSharp">
      <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(GameManaged)/HOOKS-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManaged)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NewtonsoftDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rain Meadow">
      <HintPath>$(RainMeadowDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Stage an installable mod under the build output directory. -->
  <Target Name="PackMod" AfterTargets="Build">
    <PropertyGroup>
      <ModOutDir>$(OutputPath)mod/RainMeadowAndroidExtras/</ModOutDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutDir)plugins/" />
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(ModOutDir)" />
  </Target>
</Project>